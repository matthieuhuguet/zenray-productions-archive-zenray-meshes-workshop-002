# 25 October 2026 : ZenRay Meshes car, BODY BY ROW LOFT (method change). The creased Catmull-Clark of the cage rounded
# every band BETWEEN two character lines and carried the noise of each measured station along the car (lumpy, wavy sides),
# while the sheet is made of clean bands split by crisp lines. Here every named row of the cage is a smooth curve along
# the car (monotone cubic through the stations, no overshoot), sampled densely in z, and the surface between two rows is
# straight across : crisp character lines across, smooth bands along, like the sheet. Panel names follow the cage faces.
# FR : chaque rangée nommée devient une courbe lisse le long de la voiture, la surface est droite entre deux rangées.
# Usage: python RowLoft.py <loft_params.json> <cage_prefix> <out.npz>
import sys, os, json
import numpy as np
from scipy.interpolate import PchipInterpolator


def main(params, prefix, out):
    C = json.load(open(params)); cj = json.load(open(prefix + "_cage.json"))
    st = np.array(cj["stations"]); R = cj["ring"]; S = len(st); panels = cj["panels"]
    V = np.array([list(map(float, l.split()[1:])) for l in open(prefix + "_cage.obj") if l.startswith("v ")]).reshape(S, R, 3)
    # dense samples per station interval : n_per_m along the length, at least 1 per interval
    zs, seg = [], []
    for i in range(S - 1):
        n = max(1, int(abs(st[i] - st[i + 1]) * C["n_per_m"]))
        for k in range(n): zs.append(i + k / n); seg.append(i)
    zs.append(S - 1); seg.append(S - 2)
    t = np.array(zs)                                     # station parameter (fractional index), monotone
    G = np.zeros((len(t), R, 3))
    for j in range(R):
        for a in range(3):
            G[:, j, a] = PchipInterpolator(np.arange(S), V[:, j, a])(t)
    if C.get("fair", 1):
        # 25 October 2026: FAIR ROWS. Each row (x and y along z) is a penalised cubic B-spline (P-spline : knots every knot_m,
        # second difference penalty lam), ends held by a large weight ; the arch rows ignore the stations inside the wheel
        # arches (the arches are cut afterwards), so the side runs clean from bumper to bumper.
        from scipy.interpolate import BSpline
        m = json.load(open(prefix + "_measure.json")) if os.path.exists(prefix + "_measure.json") else None
        Wh = m["wheels"] if m else None; E = cj["exp_rows"]; nh = len(E)
        row_of = lambda j: E[nh - 1 - j] if j < nh else E[j - (nh - 1)]
        zt = np.interp(t, np.arange(S), V[:, 0, 2] * 0 + st)   # sample z along the car
        zlo, zhi = st.min(), st.max(); kn = np.arange(zlo, zhi + 1e-9, C["knot_m"])
        if kn[-1] < zhi: kn = np.append(kn, zhi)
        T = np.concatenate([[zlo] * 3, kn, [zhi] * 3])
        # 25 October 2026: CLEAN CURVES ; each character line is a cubic B-spline with one knot every knot_m (few control
        # points, smooth by construction, like a designer's curve) and deliberate C0 corners (knot repeated 3 times) only at
        # the design breaks listed per row in "breaks" (windshield base, rear glass base) ; FR : courbes propres, peu de points.
        def knots_for(bz):
            pts = [zlo] + sorted(b for b in bz if zlo + 0.05 < b < zhi - 0.05) + [zhi]; inner = []
            for a_, b_ in zip(pts[:-1], pts[1:]):
                n_ = max(1, int(round((b_ - a_) / C["knot_m"]))); inner += list(np.linspace(a_, b_, n_ + 1)[1:-1])
                if b_ < zhi: inner += [b_] * 3
            return np.concatenate([[zlo] * 4, sorted(inner), [zhi] * 4])
        def fit(z, v, w, zq):
            T_ = T; B = BSpline.design_matrix(np.clip(z, zlo, zhi), T_, 3).toarray(); nb = B.shape[1]
            D = np.diff(np.eye(nb), 2, axis=0); A = B.T @ (w[:, None] * B) + C["lam"] * D.T @ D
            c = np.linalg.solve(A, B.T @ (w * v)); return BSpline.design_matrix(np.clip(zq, zlo, zhi), T, 3).toarray() @ c
        ra = Wh["tyre_r"] * C["arch_pad"] if Wh else 0
        for j in range(R):
            r = row_of(j); z = V[:, j, 2]; keep0 = np.ones(S, bool)
            if C.get("fit_skip_ends", 1): keep0[0] = keep0[-1] = False   # 25 October 2026: end faces (tips, ground shadow) pulled the floor down
            T = knots_for(C.get("breaks", {}).get(r, []))
            for a in (0, 1):
                keep = keep0.copy()
                # 25 October 2026: only the HEIGHT (y) of the arch rows is perturbed over the wheels (arch top) ; their width
                # (x) there is the real haunch bulge, so x is fitted on every station (skipping it lost the rear haunch)
                if Wh and r in C["arch_rows"] and (a == 1 or not C.get("arch_skip_x_keep", 1)):
                    keep &= np.minimum(np.abs(z - Wh["front_z"]), np.abs(z - Wh["rear_z"])) > ra * C["arch_skip"]
                w = np.where(np.arange(S)[keep] % (S - 1) == 0, C["end_weight"], 1.0)
                G[:, j, a] = fit(z[keep], V[keep, j, a], w, zt)
            G[:, j, 2] = zt
    # 26 October 2026: SHOULDER OVERHANG LIMIT ; belt_top (plan shoulder line) stood up to 3.5 cm outside the belt in the
    # middle of the doors, an undercut that rendered as a black band where the sheet shades the shoulder band softly ; the
    # belt is held at most shoulder_overhang_max inside belt_top. FR : débord de l'épaule sur la ceinture limité.
    om = C.get("shoulder_overhang_max")
    if om is not None:
        E_o = cj["exp_rows"]; nh_o = len(E_o)
        for jb, jt in ((nh_o - 1 - E_o.index("belt"), nh_o - 1 - E_o.index("belt_top")), (nh_o - 1 + E_o.index("belt"), nh_o - 1 + E_o.index("belt_top"))):
            if 0 <= jb < R and 0 <= jt < R:
                G[:, jb, 0] = np.sign(G[:, jb, 0]) * np.maximum(np.abs(G[:, jb, 0]), np.abs(G[:, jt, 0]) - om)
    # 26 October 2026: WHEEL COVER ; a car body covers its tyres in plan (the sheet's top view never shows them), so the rows
    # that frame the arches (wheel_cover.rows) are pushed out over each tyre to tyre face + cover_m by a smooth bump (a
    # max filter then a Gaussian of sigma_m along z : no kink, the curve stays clean). The top view rounds the rear corners
    # over the tyres (0.23 m off the side views at z -2.0) ; the side views and the back view win.
    # FR : la caisse couvre ses pneus vue de dessus, bosse lisse sur les rangées qui encadrent les passages.
    WC = C.get("wheel_cover")
    if WC and WC.get("on", 1):
        # 26 October 2026: the first bump (max filter of the deficit, then Gaussian) added the largest nearby deficit to points
        # that needed less (sill 1.29 m at z -1.8 for a 1.13 target) ; now new = |x| + softplus(face - |x|) * w(z), w a C2
        # plateau window over the tyre (plus extra_m per row, smootherstep ramps of ramp_m) : |x| where w = 0, max(|x|, face)
        # inside, a smooth blend between
        Wp = json.load(open(os.path.join(os.path.dirname(os.path.abspath(params)), C.get("wheels", "wheel_params.json"))))
        E_ = cj["exp_rows"]; nh_ = len(E_); zq = G[:, 0, 2]; k_ = WC.get("soft_m", 0.006); rp = WC.get("ramp_m", 0.12)
        sstep = lambda u: np.where(u <= 0, 0.0, np.where(u >= 1, 1.0, u ** 3 * (u * (6 * u - 15) + 10)))
        for rn, rc in WC["rows"].items():
            if rn not in E_: continue
            for inst in Wp["instances"]:
                if inst["x"] <= 0: continue
                if rc.get("rear_only") and inst["z"] > 0: continue   # 26 October 2026: per row, rear wheels only
                face = inst["x"] + 0.5 * Wp["tyre_w"] + Wp.get("bulge", 0.0) + WC["cover_m"] + rc.get("face_dx", 0.0)   # 26 October 2026: per row face offset
                ex = rc.get("extra_rear_m" if inst["z"] < 0 else "extra_front_m", rc.get("extra_m", 0.0))
                lo, hi = inst["z"] - Wp["tyre_r"] - (ex if inst["z"] < 0 else rc.get("extra_m", 0.0)), inst["z"] + Wp["tyre_r"] + (rc.get("extra_m", 0.0) if inst["z"] < 0 else ex)
                for j in sorted({nh_ - 1 - E_.index(rn), nh_ - 1 + E_.index(rn)}):
                    if not 0 <= j < G.shape[1]: continue
                    if rc.get("window", WC.get("window")) == "radial":   # 26 October 2026: a row can override the window (belt : z window)
                        # 26 October 2026: a FLARE ring around the arch (distance to the axle in y z), full push up to
                        # arch radius + flare_m, ramp_m beyond ; the z window left fins at the arch edges (seen from above)
                        d = np.hypot(G[:, j, 1] - inst["y"], zq - inst["z"]); R0 = Wp["tyre_r"] * C.get("arch_pad_cut", 1.14) + WC.get("flare_m", 0.1)
                        w = sstep((R0 + rp - d) / rp)
                        zf = WC.get("front_fade_z")   # 26 October 2026: no flare at the nose cut (the nose read a bulged section)
                        if zf and inst["z"] > 0: w = w * sstep((zf[1] - zq) / (zf[1] - zf[0]))
                        zr = WC.get("rear_fade_z")    # 26 October 2026: nor at the tail cut (flat slab at the face corners)
                        if zr and inst["z"] < 0: w = w * sstep((zq - zr[0]) / (zr[1] - zr[0]))
                    else:
                        rp_ = rc.get("ramp_m", rp)   # 26 October 2026: per row ramp (the rear belt push turned in 0.15 m, a kink in the shoulder)
                        w = sstep((zq - (lo - rp_)) / rp_) * sstep(((hi + rp_) - zq) / rp_)
                    ax = np.abs(G[:, j, 0]); u = face - ax
                    sp = k_ * np.logaddexp(0.0, u / k_)
                    G[:, j, 0] = np.sign(G[:, j, 0]) * (ax + sp * w)
    # 25 October 2026: CHARACTER LINE GROOVES ; a named row sinks inward by d (x toward the axis), so the two bands that meet
    # there break their normals enough to draw the line the sheet shows (belt crease, sill crease)
    if C.get("groove_rows"):
        E_ = cj["exp_rows"]; nh_ = len(E_)
        for rn, d in C["groove_rows"].items():
            if rn not in E_: continue
            for j in (nh_ - 1 - E_.index(rn), nh_ - 1 + E_.index(rn)):
                if 0 <= j < R: G[:, j, 0] -= np.sign(G[:, j, 0]) * d
    if C.get("min_y") is not None: G[:, :, 1] = np.maximum(G[:, :, 1], C["min_y"])   # 25 October 2026: no row below the floor plane
    # 26 October 2026: SKIRT BELOW THE FLOOR ; the back view puts the underside between the tyres at y 0.17 while the side
    # views see a bottom line at 0.126 : the side skirt (sill) hangs lower than the floor. row_y_min raises the floor rows,
    # row_dy lowers a row between the wheels with smootherstep ramps (z window, ramp_m). FR : jupe plus basse que le plancher.
    E_y = cj["exp_rows"]; nh_y = len(E_y); zq_y = G[:, 0, 2]
    sst_ = lambda u: np.where(u <= 0, 0.0, np.where(u >= 1, 1.0, u ** 3 * (u * (6 * u - 15) + 10)))
    for rn, ym in C.get("row_y_min", {}).items():
        if rn in E_y:
            for j in sorted({nh_y - 1 - E_y.index(rn), nh_y - 1 + E_y.index(rn)}): G[:, j, 1] = np.maximum(G[:, j, 1], ym)
    for rn, sp_ in [(rn_, s_) for rn_, v_ in C.get("row_dy", {}).items() for s_ in (v_ if isinstance(v_, list) else [v_])]:   # 26 October 2026: a row may carry a list of windows
        if rn not in E_y: continue
        z0_, z1_ = sp_["z"]; rp_ = sp_.get("ramp_m", 0.2)
        w_ = sst_((zq_y - (z0_ - rp_)) / rp_) * sst_(((z1_ + rp_) - zq_y) / rp_)
        for j in sorted({nh_y - 1 - E_y.index(rn), nh_y - 1 + E_y.index(rn)}):   # 26 October 2026: centre rows have one column
            if 0 <= j < R: G[:, j, 1] += sp_["dy"] * w_
    # 26 October 2026: row_dx moves a row's |x| by dx (negative = inward) in a z window with smootherstep ramps ; the sheet's
    # band under the lower door crease is darker (it tucks in toward the sill), the model's was vertical. FR : retrait en x.
    for rn, sp_ in C.get("row_dx", {}).items():
        if rn not in E_y: continue
        z0_, z1_ = sp_["z"]; rp_ = sp_.get("ramp_m", 0.2)
        w_ = sst_((zq_y - (z0_ - rp_)) / rp_) * sst_(((z1_ + rp_) - zq_y) / rp_)
        for j in sorted({nh_y - 1 - E_y.index(rn), nh_y - 1 + E_y.index(rn)}):   # 26 October 2026: centre rows have one column
            if 0 <= j < R: G[:, j, 0] = np.sign(G[:, j, 0]) * (np.abs(G[:, j, 0]) + sp_["dx"] * w_)
    # 26 October 2026: ROW X TARGET ; a row's |x| follows a target plan polyline (z, x) read on the top view, weight 1 over
    # the polyline's z span, smootherstep ramps ahead (ramp_front_m) and behind (ramp_back_m) back to the fitted row. The
    # P-spline (one knot every 0.9 m) cannot follow the quarter window's outer edge, which runs in 13 cm between z -0.73
    # and its tip at -1.2 ; the row stayed at 0.776 (top view). FR : une rangée suit une polyligne de plan dans une fenêtre.
    # 26 October 2026: a row may carry a LIST of targets (separate z windows, e.g. A pillar and rear glass), the middle stays fitted
    for rn, sp_ in [(rn_, s_) for rn_, v_ in C.get("row_x_target", {}).items() for s_ in (v_ if isinstance(v_, list) else [v_])]:
        if rn not in E_y or not sp_.get("on", 1): continue
        pz, px = np.array(sp_["pts"], float).T; o_ = np.argsort(pz); pz, px = pz[o_], px[o_]
        rf_, rb_ = sp_.get("ramp_front_m", 0.1), sp_.get("ramp_back_m", 0.3)
        w_ = np.where(zq_y > pz[-1], sst_(1.0 - (zq_y - pz[-1]) / rf_), np.where(zq_y < pz[0], sst_(1.0 - (pz[0] - zq_y) / rb_), 1.0))
        # 26 October 2026: monotone cubic (PCHIP, C1) through the traced points, clamped outside ; a linear polyline put
        # corners inside the quarter glass slant cut window and the sheared rows crossed them at different heights (teeth)
        xt_ = PchipInterpolator(pz, px)(np.clip(zq_y, pz[0], pz[-1])) if sp_.get("smooth", 1) and len(pz) > 2 else np.interp(zq_y, pz, px)
        if sp_.get("fit") == "poly" and len(pz) > sp_.get("deg", 3):   # 26 October 2026: same smoothing option as row_y_target
            xt_ = np.polyval(np.polyfit(pz, px, sp_.get("deg", 3)), np.clip(zq_y, pz[0], pz[-1]))
        for j in sorted({nh_y - 1 - E_y.index(rn), nh_y - 1 + E_y.index(rn)}):
            G[:, j, 0] = np.sign(G[:, j, 0]) * (np.abs(G[:, j, 0]) + w_ * (xt_ - np.abs(G[:, j, 0])))
    # 26 October 2026: ROW Y TARGET ; the same tool in height : a side row follows a target side view polyline (z, y) read on
    # both side views (mean of left and right), weight 1 over its z span, smootherstep ramps back to the fitted row. The lower
    # door crease rises 18 cm from the door front to the rear arch on the sheet, the fitted door_low row (one knot every
    # 0.9 m, plus a flat row_dy) sat 1.7 cm low at mid door and 2.5 cm high before the rear arch. FR : une rangée suit une
    # polyligne de côté (z, y) dans une fenêtre.
    for rn, sp_ in [(rn_, s_) for rn_, v_ in C.get("row_y_target", {}).items() for s_ in (v_ if isinstance(v_, list) else [v_])]:
        if rn not in E_y or not sp_.get("on", 1): continue
        pz, py = np.array(sp_["pts"], float).T; o_ = np.argsort(pz); pz, py = pz[o_], py[o_]
        rf_, rb_ = sp_.get("ramp_front_m", 0.1), sp_.get("ramp_back_m", 0.1)
        w_ = np.where(zq_y > pz[-1], sst_(1.0 - (zq_y - pz[-1]) / rf_), np.where(zq_y < pz[0], sst_(1.0 - (pz[0] - zq_y) / rb_), 1.0))
        yt_ = PchipInterpolator(pz, py)(np.clip(zq_y, pz[0], pz[-1])) if sp_.get("smooth", 1) and len(pz) > 2 else np.interp(zq_y, pz, py)
        if sp_.get("fit") == "poly" and len(pz) > sp_.get("deg", 3):   # 26 October 2026: a least squares polynomial through the traced points ; PCHIP through every point carried the measurement noise (door_low 3 -> 14 inflections)
            yt_ = np.polyval(np.polyfit(pz, py, sp_.get("deg", 3)), np.clip(zq_y, pz[0], pz[-1]))
        for j in sorted({nh_y - 1 - E_y.index(rn), nh_y - 1 + E_y.index(rn)}):
            if 0 <= j < R: G[:, j, 1] = G[:, j, 1] + w_ * (yt_ - G[:, j, 1])
    # 25 October 2026: ROW ORDER ; from the sill up, each row stays above the row below (row_gap_m) and, from the glass
    # base up, inside it in x : rows never cross, so no fold in any section (ShapeCheck "folds")
    if C.get("order_rows", 1):
        E_ = cj["exp_rows"]; nh_ = len(E_)
        for side in (1, -1):
            prev = None
            for k in range(E_.index("sill"), nh_):
                j = ((nh_ - 1 + k) if side > 0 else (nh_ - 1 - k)) % R
                if prev is not None:
                    G[:, j, 1] = np.maximum(G[:, j, 1], G[:, prev, 1] + C.get("row_gap_m", 0.003))
                    if E_[k] in C.get("inward_rows", ["glass_base", "roof_edge"]):
                        G[:, j, 0] = np.sign(G[:, j, 0]) * np.minimum(np.abs(G[:, j, 0]), np.abs(G[:, prev, 0]))
                prev = j
    # 25 October 2026: CROWN ; the top band (roof_centre -> roof_edge, roof and hood) was a straight ruled strip, a tent
    # with a ridge in the front view ; crown_n columns are inserted, x linear and y = yc + (ye - yc) * u**crown_p, flat top
    # that drops near its edges, as the sheet. Panels of the inserted strips follow their band.
    cols = []
    cn, cp = C.get("crown_n", 0), C.get("crown_p", 3.0)
    # 26 October 2026: SUPERELLIPSE CROWN ; the end views of the sheet show a flat roof with a tight corner (front view top
    # 1.334 m out to x 0.5, 1.315 at 0.6, then down), the power law u**3 made a dome (model 1.5 to 3 cm high in the middle,
    # 3 to 6 cm low at x 0.5 to 0.65). crown_superellipse n : y = ye + (yc - ye) * (1 - u**n)**(1/n), a quarter superellipse
    # (vertical tangent at the roof edge row), columns spread by the superellipse angle so the corner gets them
    cse = C.get("crown_superellipse")
    def crown(ja, jb, ua, ub):   # ja centre column, jb edge column
        out = []
        for k in range(1, cn + 1):
            u = np.sin(0.5 * np.pi * k / (cn + 1)) ** (2.0 / cse) if cse else k / (cn + 1)
            u = ua + (ub - ua) * u
            out.append((ja, jb, u))
        # 26 October 2026: CROWN EXTRA COLUMNS ; the rail joint (col u 0.91) sat between crown columns 12 cm apart (u 0.80
        # and 0.98), its groove was a soft valley and the top view missed the rail inner edge (1.25 m) ; extra columns
        # close to it make the V sharp, as side_edge does on the flank. FR : colonnes de bombement en plus près du joint.
        for ue in C.get("crown_extra_u", []):
            out.append((ja, jb, ua + (ub - ua) * ue))
        out.sort(key=lambda o: o[2])
        return out
    if cse: cp = -float(cse)   # negative power = superellipse exponent (read in the column interpolation below)
    # 26 October 2026: SIDE SUBDIVISION ; a side band (sill to door_low, door_low to belt ...) was ONE quad tall (0.3 to 0.4 m),
    # so the arch cut, which removes quads by their centre, left a tongue hanging in the middle of the rear arch and square
    # corners beside it ; side_subdiv n inserts n - 1 straight columns in every band between two rows of side_rows (the
    # band is ruled, the shape does not change), and the cut then follows the circle. FR : bandes de flanc subdivisées.
    E_s = cj["exp_rows"]; nh_s = len(E_s); ss = int(C.get("side_subdiv", 1)); srow = set(C.get("side_rows", []))
    vent_k = []   # 26 October 2026: columns moved onto the vent's lower edge
    vent_slot = []   # 26 October 2026: slot columns to put back on their segment outside the vent window
    edge_rec, edge_idx = [], []   # 26 October 2026: side edge columns (row, other row, column index)
    rname = lambda j: E_s[nh_s - 1 - j] if j < nh_s else E_s[j - (nh_s - 1)]
    for j in range(R):
        cols.append((j, j, 0.0, j, 1.0))
        if cn and j == 0: cols += [(0, 1, u, 0, cp) for (_, _, u) in crown(0, 1, 0, 1)]
        if cn and j == R - 1: cols += [(0, R - 1, u, R - 1, cp) for (_, _, u) in crown(0, R - 1, 0, 1)[::-1]]
        if ss > 1 and j < R - 1 and rname(j) in srow and rname(j + 1) in srow:
            us_ = [k / ss for k in range(1, ss)]
            # 26 October 2026: SIDE EDGE COLUMNS ; the panel joint groove (CarPanels : border points sink 12 mm along the
            # normal) spans the first inserted strip on each side of the row, 2 to 6 cm wide, so the lower door joint was a
            # soft 35 degree valley and drew no line where the sheet draws the crease (light edge and shadow, 2 cm apart).
            # A column side_edge.m away from a listed row (per station fraction of the band width) makes the groove a sharp
            # V. FR : une colonne fine de part et d'autre de la rangée, la rainure du joint devient nette.
            SE_ = C.get("side_edge")
            if SE_ and SE_.get("on", 1):
                h_ = np.maximum(np.linalg.norm(G[:, j + 1, :2] - G[:, j, :2], axis=1), 1e-3); ue_ = np.clip(SE_["m"] / h_, 0.005, 0.45 / ss)
                if rname(j) in SE_["rows"]: us_.append(ue_); edge_rec.append((rname(j), rname(j + 1), us_[-1]))
                if rname(j + 1) in SE_["rows"]: us_.append(1.0 - ue_); edge_rec.append((rname(j + 1), rname(j), us_[-1]))
                us_.sort(key=lambda v_: float(np.mean(v_)))
            # 26 October 2026: VENT ; the front fender vent of the sheet (a slot under the shoulder line, tip at z 0.95, open
            # to the door joint) : the inserted column of the band nearest to the vent's lower edge is moved onto it (per
            # station fraction, smootherstep in and out of the z window) and pushed in later by depth_pts. FR : ouïe d'aile.
            VT_ = C.get("vent")
            if VT_ and VT_.get("on", 1) and {rname(j), rname(j + 1)} == set(VT_["band"]):
                zr_ = G[:, j, 2]; yp_ = np.array(VT_["y_pts"], float); o_ = np.argsort(yp_[:, 0]); yp_ = yp_[o_]
                yv_ = np.interp(zr_, yp_[:, 0], yp_[:, 1]); ya_, yb_ = G[:, j, 1], G[:, j + 1, 1]
                ut_ = np.clip((yv_ - ya_) / np.where(np.abs(yb_ - ya_) < 1e-6, 1e-6, yb_ - ya_), 0.05, 0.95)
                rpv = VT_.get("ramp_m", 0.05); zv0, zv1 = yp_[0, 0], yp_[-1, 0]
                sstv = lambda u: np.where(u <= 0, 0.0, np.where(u >= 1, 1.0, u ** 3 * (u * (6 * u - 15) + 10)))
