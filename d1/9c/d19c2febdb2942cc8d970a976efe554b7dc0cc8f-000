# 25 October 2026 : ZenRay Meshes car, wire the FACETED NOSE in Houdini : a Clip SOP on the body panels keeps only z below
# cut_z (exact planar cut, read from <nose>_cut.json), and a Python SOP loads the nose npz into the "car" merge.
# CTRL_zrm/nose_on switches the facet nose (0 = the subdivided nose as before). Run with g = {"NOSE": npz path}.
# FR : coupe la caisse au plan z = cut_z et charge le nez en facettes ; interrupteur nose_on sur CTRL_zrm.
import hou, json
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
geo = hou.node("/obj/ZRM_Car"); ctrl = geo.node("CTRL_zrm"); npz = globals()["NOSE"]
cut = json.load(open(npz.replace(".npz", "_cut.json")))["cut_z"]
ptg = ctrl.parmTemplateGroup()
for n, l, v in (("nose_on", "Faceted Nose", 1), ):
    if not ctrl.parm(n): ptg.append(hou.IntParmTemplate(n, l, 1, default_value=(v,)))
if not ctrl.parm("nose_cut_z"): ptg.append(hou.FloatParmTemplate("nose_cut_z", "Nose Cut z (m)", 1, default_value=(cut,)))
ctrl.setParmTemplateGroup(ptg); ctrl.parm("nose_cut_z").set(cut)
na = geo.node("arch_cut_switch") or geo.node("panel_name"); out = geo.node("OUT_panels")   # 25 October 2026: after the arch cut
cl = geo.node("nose_clip") or geo.createNode("clip", "nose_clip")
cl.setInput(0, na); out.setInput(0, cl)
cl.parm("originz").setExpression('ch("../CTRL_zrm/nose_cut_z")'); cl.parm("dirx").set(0); cl.parm("diry").set(0); cl.parm("dirz").set(-1)
cl.parm("clipop").set(0)
cl.bypass(False); cl.parm("dist").set(0)
sw_ = geo.node("nose_on_switch") or geo.createNode("switch", "nose_on_switch")
sw_.setInput(0, na); sw_.setInput(1, cl); out.setInput(0, sw_); sw_.parm("input").setExpression('ch("../CTRL_zrm/nose_on")')
g = {"GEO": "/obj/ZRM_Car", "NODE": "IN_nose_v1", "NPZ": npz, "MERGE": "car", "INPUT": 4}
exec(open(W + "/Scripts/HouNpzSop.py").read(), g)
nz = geo.node("IN_nose_v1"); nz.parm("python").set(nz.parm("python").eval())
for n_ in (cl, sw_): n_.moveToGoodPosition()
gg = out.geometry(); zs = [p.position()[2] for p in gg.points()]
result = {"body_zmax": max(zs), "nose_prims": len(nz.geometry().prims()), "errors": cl.errors() + nz.errors()}
# 25 October 2026: the nose facets are cut by the same wheel arch cylinders as the body (they covered the front of the
# front arches) ; surface A, solid B, winding chosen as the one keeping the most faces.
cyl = geo.node("loft_arch_cyl")
if cyl is not None:
    nb = geo.node("nose_arch_cut") or geo.createNode("boolean::2.0", "nose_arch_cut"); nb.setInput(0, nz)
    for pn, v in (("booleanop", "subtract"), ("asurface", "surface"), ("bsurface", "solid")):
        if nb.parm(pn):
            try: nb.parm(pn).set(v)
            except Exception: pass
    best = None
    for b_ in (cyl, geo.node("loft_arch_cyl_rev")):
        nb.setInput(1, b_); n_ = len(nb.geometry().prims())
        if best is None or n_ > best[0]: best = (n_, b_)
    nb.setInput(1, best[1]); geo.node("car").setInput(4, nb); nb.moveToGoodPosition()
    result["nose_cut_prims"] = best[0]
    # 26 October 2026: the Boolean SOP triangulates and re-merges every face (n-gons of 6 to 10 sides, non-manifold edges,
    # TopoCheck) even where it cuts nothing ; it is bypassed when the nose box does not reach any arch cylinder.
    # FR : le booléen est court-circuité quand le nez ne touche aucun passage de roue.
    _gb = nz.geometry().boundingBox(); _cb = best[1].geometry().boundingBox()
    _touch = all(_gb.minvec()[k] <= _cb.maxvec()[k] and _cb.minvec()[k] <= _gb.maxvec()[k] for k in range(3))
    nb.bypass(not _touch); result["nose_cut_bypassed"] = not _touch
